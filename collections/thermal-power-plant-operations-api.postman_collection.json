                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) EIA API key."
                },
                {
                  "disabled": false,
                  "key": "frequency",
                  "value": "monthly",
                  "description": "Data frequency."
                },
                {
                  "disabled": false,
                  "key": "data[]",
                  "value": "<string>",
                  "description": "Data columns (e.g., generation, total-consumption, consumption-for-eg, heat-content, heat-rate)."
                },
                {
                  "disabled": false,
                  "key": "facets[plantCode][]",
                  "value": "<string>",
                  "description": "EIA plant code identifier."
                },
                {
                  "disabled": false,
                  "key": "facets[fuel2002][]",
                  "value": "<string>",
                  "description": "Fuel type code filter (e.g., NG, COL, DFO, NUC)."
                },
                {
                  "disabled": false,
                  "key": "facets[state][]",
                  "value": "<string>",
                  "description": "US state abbreviation."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "Start period in YYYY-MM format."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "End period in YYYY-MM format."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset."
                },
                {
                  "disabled": false,
                  "key": "length",
                  "value": "5000",
                  "description": "Number of records to return (max 5000)."
                }
              ],
              "variable": []
            },
            "header": [
