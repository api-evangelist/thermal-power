          "name": "Get Facility Fuel Data",
          "request": {
            "name": "Get Facility Fuel Data",
            "description": {
              "content": "Retrieves annual and monthly electric power operational data for individual thermal power plants, including generation, fuel consumption, heat content, and heat rate by plant, state, and fuel type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "electricity",
                "facility-fuel",
                "data"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
